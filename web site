                        <div>
                            <label class="block text-[11px] font-medium text-slate-400 mb-1">Category</label>
                            <select id="filter-category" onchange="applyLibraryFilters()" class="w-full bg-bgDark border border-panelBorder rounded-lg px-2.5 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-blue-500">
                                <option value="ALL">All Categories</option>
                                <option value="Roblox Development">Roblox Development</option>
                                <option value="Website Development">Website Development</option>
                                <option value="Python Development">Python Development</option>
                                <option value="JavaScript Development">JavaScript Development</option>
                                <option value="C dan C++">C dan C++</option>
                                <option value="AI Development">AI Development</option>
                                <option value="Script Security">Script Security</option>
                                <option value="Debugging dan Perbaikan">Debugging dan Perbaikan</option>
                                <option value="Game Development">Game Development</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[11px] font-medium text-slate-400 mb-1">Language</label>
                            <select id="filter-language" onchange="applyLibraryFilters()" class="w-full bg-bgDark border border-panelBorder rounded-lg px-2.5 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-blue-500">
                                <option value="ALL">All Languages</option>
                                <option value="Luau / Lua">Luau / Lua</option>
                                <option value="JavaScript / React">JavaScript / React</option>
                                <option value="Python">Python</option>
                                <option value="C++ / C">C++ / C</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[11px] font-medium text-slate-400 mb-1">Difficulty</label>
                            <select id="filter-difficulty" onchange="applyLibraryFilters()" class="w-full bg-bgDark border border-panelBorder rounded-lg px-2.5 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-blue-500">
                                <option value="ALL">All Levels</option>
                                <option value="Beginner">Beginner</option>
                                <option value="Intermediate">Intermediate</option>
                                <option value="Advanced">Advanced</option>
                                <option value="Expert">Expert</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-[11px] font-medium text-slate-400 mb-1">Search Keywords</label>
                            <input type="text" id="filter-search" oninput="applyLibraryFilters()" placeholder="Search title..." class="w-full bg-bgDark border border-panelBorder rounded-lg px-2.5 py-1.5 text-xs text-slate-200 focus:outline-none focus:border-blue-500">
                        </div>
                    </div>
                </div>

                <div id="library-prompt-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
            </section>

            <!-- VIEW: PROMPT BUILDER -->
            <section id="view-builder" class="hidden space-y-6">
                <div class="bg-panelDark p-4 rounded-xl border border-panelBorder">
                    <h1 class="text-xl font-bold text-white">Interactive Prompt Builder</h1>
                    <p class="text-xs text-slate-400">Generate structured, high-context developer prompts tailored to your exact script requirements.</p>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    <div class="lg:col-span-6 bg-panelDark border border-panelBorder rounded-xl p-5 space-y-4">
                        <div>
                            <label class="block text-xs font-medium text-slate-300 mb-1">Project Name</label>
                            <input type="text" id="pb-title" placeholder="e.g. DataStore Manager" class="w-full bg-bgDark border border-panelBorder rounded-lg p-2 text-xs text-slate-200 focus:outline-none focus:border-blue-500">
                        </div>
                        <button onclick="generateCustomPrompt()" class="w-full py-2.5 bg-blue-600 hover:bg-blue-500 text-white font-semibold rounded-lg text-xs transition-all shadow-md">
                            Generate Master Prompt
                        </button>
                    </div>
                    <div class="lg:col-span-6 flex flex-col bg-panelDark border border-panelBorder rounded-xl p-5">
                        <textarea id="pb-output" readonly class="flex-1 w-full bg-bgDark border border-panelBorder rounded-lg p-3 text-xs font-mono text-emerald-400 focus:outline-none min-h-[350px] resize-none" placeholder="Generated prompt..."></textarea>
                    </div>
                </div>
            </section>

            <!-- VIEW: LUAU ERROR DEBUGGER -->
            <section id="view-debugger" class="hidden space-y-6">
                <div class="bg-panelDark p-4 rounded-xl border border-panelBorder">
                    <h1 class="text-xl font-bold text-white">Roblox Luau Error Debugger & Fixer Studio</h1>
                    <p class="text-xs text-slate-400">Masukkan kode Luau yang bermasalah untuk menghasilkan prompt perbaikan otomatis.</p>
                </div>
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-6">
                    <div class="lg:col-span-6 bg-panelDark border border-panelBorder rounded-xl p-5 space-y-4">
                        <textarea id="dbg-code" rows="8" placeholder="Paste problem Luau code here..." class="w-full bg-bgDark border border-panelBorder rounded-lg p-2 text-xs font-mono text-slate-200 focus:outline-none"></textarea>
                        <button onclick="generateDebuggerPrompt()" class="w-full py-2.5 bg-rose-600 hover:bg-rose-500 text-white font-semibold rounded-lg text-xs transition-all">Generate Luau Debug Prompt</button>
                    </div>
                    <div class="lg:col-span-6 flex flex-col bg-panelDark border border-panelBorder rounded-xl p-5">
                        <textarea id="dbg-output" readonly class="flex-1 w-full bg-bgDark border border-panelBorder rounded-lg p-3 text-xs font-mono text-rose-300 focus:outline-none min-h-[350px] resize-none" placeholder="Debug output..."></textarea>
                    </div>
                </div>
            </section>

            <!-- VIEW: MY WORKSPACE -->
            <section id="view-workspace" class="hidden space-y-6">
                <div class="bg-panelDark p-4 rounded-xl border border-panelBorder">
                    <h1 class="text-xl font-bold text-white">Personal Prompt Workspace</h1>
                    <p class="text-xs text-slate-400">Manage saved favorites and streamed prompts.</p>
                </div>
                <div id="workspace-grid" class="grid grid-cols-1 md:grid-cols-2 gap-4"></div>
            </section>
        </main>
    </div>

    <!-- MAIN JAVASCRIPT & LIVE AI STREAMER ENGINE -->
    <script>
        const INITIAL_PROMPTS = [
            {
                id: "p-luau-datastore",
                title: "Roblox Luau Secure DataStore2/ProfileService Architecture",
                category: "Roblox Development",
                language: "Luau / Lua",
                difficulty: "Advanced",
                description: "Generates robust server-side data persistence script with session locking and pcall error handling.",
                content: `Bertindaklah sebagai Roblox Luau engineer senior. Analisis kebutuhan sistem save data game Roblox, lalu rancang Script Server menggunakan ProfileService / DataStore2 dengan pcall dan Session Locking.`
            },
            {
                id: "p-luau-cframe-anim",
                title: "Roblox Luau CFrame Prop & Cutscene Controller",
                category: "Roblox Development",
                language: "Luau / Lua",
                difficulty: "Intermediate",
                description: "Smooth CFrame interpolation system for prop positioning and camera animation.",
                content: `Bertindaklah sebagai Roblox Luau animation engineer. Buat sistem animasi props berbasis CFrame dengan TweenService dan Maid connection cleanup.`
            }
        ];

        // Generator Pool untuk AI Streamer otomatis tiap detik
        const STREAMER_TEMPLATES = [
            { title: "Live Luau Auto-Save Module v", cat: "Roblox Development", lang: "Luau / Lua", diff: "Advanced", desc: "Autonomously generated persistent DataStore wrapper with debounce.", content: "Bertindaklah sebagai Roblox Luau Engineer. Buat modul Auto-Save dengan debounce 10 detik dan session lock." },
            { title: "Live Python FastAPI Endpoint v", cat: "Python Development", lang: "Python", diff: "Intermediate", desc: "Autonomously generated high-speed asynchronous REST endpoint.", content: "Bertindaklah sebagai Senior Python Developer. Buat endpoint FastAPI async dengan pydantic model validation." },
            { title: "Live React Tailwind Component v", cat: "Website Development", lang: "JavaScript / React", diff: "Intermediate", desc: "Autonomously generated dashboard stats widget with dark UI.", content: "Bertindaklah sebagai React Expert. Buat komponen Dashboard Grid responsif dengan Tailwind CSS dark mode." },
            { title: "Live Luau Raycast Combat Hitbox v", cat: "Roblox Development", lang: "Luau / Lua", diff: "Expert", desc: "Autonomously generated server-side sword swing raycast validator.", content: "Bertindaklah sebagai Roblox Combat Engineer. Buat sistem raycast melee hitbox dengan verifikasi server-side authority." }
        ];

        let appState = {
            prompts: [],
            favorites: [],
            history: [],
            streamedPrompts: [],
            isStreamerPaused: false,
            activeTab: 'dashboard'
        };

        window.onload = function() {
            loadFromStorage();
            if (appState.prompts.length === 0) {
                appState.prompts = [...INITIAL_PROMPTS];
                saveToStorage();
            }
            renderDashboard();
            renderRobloxHub();
            renderLibrary();
            renderWorkspace();
            
            // NYALAKAN MESIN AI STREAMER OTOMATIS TIAP 1 DETIK (1000ms)
            setInterval(runLiveAiStreamerTick, 1000);
            logActivity("Live AI Streamer engine activated (1s interval).");
        };

        function loadFromStorage() {
            try {
                const storedPrompts = localStorage.getItem('sps_prompts');
                const storedFavs = localStorage.getItem('sps_favorites');
                const storedHist = localStorage.getItem('sps_history');
                if (storedPrompts) appState.prompts = JSON.parse(storedPrompts);
                if (storedFavs) appState.favorites = JSON.parse(storedFavs);
                if (storedHist) appState.history = JSON.parse(storedHist);
            } catch (err) {}
        }

        function saveToStorage() {
            try {
                localStorage.setItem('sps_prompts', JSON.stringify(appState.prompts));
                localStorage.setItem('sps_favorites', JSON.stringify(appState.favorites));
                localStorage.setItem('sps_history', JSON.stringify(appState.history));
            } catch (err) {}
        }

        function logActivity(text) {
            const timeStr = new Date().toLocaleTimeString([], { hour: '2-digit', minute: '2-digit', second: '2-digit' });
            appState.history.unshift(`[${timeStr}] ${text}`);
            if (appState.history.length > 25) appState.history.pop();
            saveToStorage();
        }

        // MESIN UTAMA: MEMBUAT PROMPT BARU OTOMATIS TIAP 1 DETIK
        function runLiveAiStreamerTick() {
            if (appState.isStreamerPaused) return;

            const template = STREAMER_TEMPLATES[Math.floor(Math.random() * STREAMER_TEMPLATES.length)];
            const randId = Math.floor(Math.random() * 9000) + 1000;
            const newPrompt = {
                id: 'p-stream-' + Date.now(),
                title: `${template.title}.${randId}`,
                category: template.cat,
                language: template.lang,
                difficulty: template.diff,
                description: template.desc,
                content: `${template.content} [Timestamp: ${new Date().toLocaleTimeString()}]`
            };

            // Masukkan ke daftar prompt utama & feed streamed
            appState.prompts.unshift(newPrompt);
            appState.streamedPrompts.unshift(newPrompt);
            if (appState.streamedPrompts.length > 20) appState.streamedPrompts.pop();

            saveToStorage();
            renderMetrics();
            
            // Update Ticker di Dashboard & Streamer Feed jika aktif
            const ticker = document.getElementById('dashboard-live-ticker');
            if (ticker) {
                ticker.innerHTML = `<span class="text-emerald-400 font-bold">[NEW AI PROMPT SYNTHESIZED]</span> ${escapeHTML(newPrompt.title)} (${newPrompt.category}) — Click to copy.`;
            }

            const feedContainer = document.getElementById('streamer-feed-container');
            if (feedContainer && appState.activeTab === 'streamer') {
                renderStreamerFeed();
            }

            const statStreamed = document.getElementById('streamer-stat-total');
            if (statStreamed) {
                statStreamed.innerText = appState.streamedPrompts.length;
            }
        }

        function toggleStreamerPause() {
            appState.isStreamerPaused = !appState.isStreamerPaused;
            const statusBadge = document.getElementById('streamer-status-badge');
            const statStatus = document.getElementById('streamer-stat-status');
            const btn1 = document.getElementById('btn-streamer-toggle');
            const btn2 = document.getElementById('btn-streamer-toggle-2');

            if (appState.isStreamerPaused) {
                if (statusBadge) { statusBadge.innerText = "PAUSED"; statusBadge.className = "text-amber-400 font-mono font-bold"; }
                if (statStatus) statStatus.innerText = "Stream Paused";
                if (btn1) btn1.innerText = "Resume Stream";
                if (btn2) btn2.innerText = "Resume Stream";
                showToast("Live AI Streamer paused.");
            } else {
                if (statusBadge) { statusBadge.innerText = "ACTIVE (1s)"; statusBadge.className = "text-emerald-400 font-mono font-bold animate-pulse"; }
                if (statStatus) statStatus.innerText = "Streaming Active";
                if (btn1) btn1.innerText = "Pause Stream";
                if (btn2) btn2.innerText = "Pause Stream";
                showToast("Live AI Streamer resumed.");
            }
        }

        function clearStreamedPrompts() {
            appState.streamedPrompts = [];
            renderStreamerFeed();
            showToast("Stream feed cleared.");
        }

        function renderStreamerFeed() {
            const container = document.getElementById('streamer-feed-container');
            if (!container) return;
            if (appState.streamedPrompts.length === 0) {
                container.innerHTML = `<div class="p-8 text-center text-slate-500 border border-dashed border-panelBorder rounded-xl">Streamer is paused or waiting for next tick...</div>`;
                return;
            }
            container.innerHTML = appState.streamedPrompts.map(p => createPromptCardHTML(p)).join('');
        }

        function switchTab(tabId) {
            appState.activeTab = tabId;
            document.querySelectorAll('main > section').forEach(sec => sec.classList.add('hidden'));
            const target = document.getElementById(`view-${tabId}`);
            if (target) target.classList.remove('hidden');

            document.querySelectorAll('.nav-btn').forEach(btn => btn.classList.remove('active', 'bg-slate-800/80', 'text-white'));
            const activeNav = document.getElementById(`nav-${tabId}`);
            if (activeNav) activeNav.classList.add('active', 'bg-slate-800/80', 'text-white');

            if (tabId === 'streamer') renderStreamerFeed();

            document.getElementById('sidebar').classList.add('-translate-x-full');
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function toggleMobileSidebar() {
            document.getElementById('sidebar').classList.toggle('-translate-x-full');
        }

        function renderMetrics() {
            document.getElementById('stat-total-prompts').innerText = appState.prompts.length;
            document.getElementById('stat-streamed-count').innerText = appState.streamedPrompts.length;
            document.getElementById('stat-total-favorites').innerText = appState.favorites.length;
            document.getElementById('stat-total-history').innerText = appState.history.length;
        }

        function renderDashboard() {
            renderMetrics();
            const recentContainer = document.getElementById('dashboard-recent-prompts');
            if (recentContainer) {
                recentContainer.innerHTML = appState.prompts.slice(0, 4).map(p => createPromptCardHTML(p)).join('');
            }
        }

        function renderRobloxHub() {
            const grid = document.getElementById('roblox-hub-grid');
            if (!grid) return;
            grid.innerHTML = appState.prompts.filter(p => p.category === 'Roblox Development').slice(0, 6).map(p => createPromptCardHTML(p)).join('');
        }

        function renderLibrary() { applyLibraryFilters(); }

        function applyLibraryFilters() {
            const cat = document.getElementById('filter-category')?.value || 'ALL';
            const search = (document.getElementById('filter-search')?.value || '').toLowerCase();
            let filtered = appState.prompts.filter(p => {
                if (cat !== 'ALL' && p.category !== cat) return false;
                if (search && !p.title.toLowerCase().includes(search)) return false;
                return true;
            });
            const grid = document.getElementById('library-prompt-grid');
            if (grid) {
                grid.innerHTML = filtered.length === 0 ? `<div class="col-span-full py-12 text-center text-slate-500">No prompts found.</div>` : filtered.map(p => createPromptCardHTML(p)).join('');
            }
        }

        function createPromptCardHTML(prompt) {
            const isFav = appState.favorites.includes(prompt.id);
            return `
                <div class="bg-panelDark border border-panelBorder rounded-xl p-4 flex flex-col justify-between hover:border-slate-700 transition-all">
                    <div>
                        <div class="flex items-start justify-between gap-2 mb-2">
                            <span class="px-2 py-0.5 text-[10px] font-semibold rounded bg-emerald-950/80 text-emerald-400 border border-emerald-800/40">${escapeHTML(prompt.category)}</span>
                            <div class="flex items-center gap-1">
                                <span class="px-2 py-0.5 text-[10px] font-mono text-slate-400 bg-bgDark rounded border border-panelBorder">${escapeHTML(prompt.language)}</span>
                                <button onclick="toggleFavorite('${prompt.id}')" class="p-1 text-slate-500 hover:text-amber-400 transition-colors">
                                    <svg class="w-4 h-4 ${isFav ? 'text-amber-400 fill-amber-400' : ''}" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"/></svg>
                                </button>
                            </div>
                        </div>
                        <h3 class="text-sm font-bold text-white mb-1">${escapeHTML(prompt.title)}</h3>
                        <p class="text-xs text-slate-400 mb-3">${escapeHTML(prompt.description)}</p>
                        <div class="bg-bgDark border border-panelBorder rounded-lg p-2.5 mb-3 max-h-28 overflow-y-auto">
                            <pre class="text-[11px] font-mono text-slate-300 whitespace-pre-wrap">${escapeHTML(prompt.content)}</pre>
                        </div>
                    </div>
                    <div class="flex items-center justify-between pt-3 border-t border-panelBorder text-xs">
                        <span class="text-[10px] text-slate-500 font-mono">Difficulty: ${escapeHTML(prompt.difficulty)}</span>
                        <button onclick="copyTextToClipboard(\`${escapeJsString(prompt.content)}\`, 'Prompt Copied!')" class="px-2.5 py-1 bg-blue-600 hover:bg-blue-500 text-white rounded font-medium">Copy</button>
                    </div>
                </div>
            `;
        }

        function toggleFavorite(id) {
            const idx = appState.favorites.indexOf(id);
            if (idx > -1) { appState.favorites.splice(idx, 1); showToast("Removed favorite."); }
            else { appState.favorites.push(id); showToast("Added to favorites!"); }
            saveToStorage();
            renderMetrics();
            applyLibraryFilters();
        }

        function generateCustomPrompt() {
            const title = document.getElementById('pb-title').value || "Custom Script";
            document.getElementById('pb-output').value = `Bertindaklah sebagai Senior Software Engineer. Buat modul untuk [${title}] dengan validasi ketat dan penanganan error pcall.`;
            showToast("Prompt generated!");
        }

        function generateDebuggerPrompt() {
            const code = document.getElementById('dbg-code').value;
            document.getElementById('dbg-output').value = `Analisis error pada kode berikut:\n\`\`\`lua\n${code}\n\`\`\`\nTunjukkan akar masalah dan berikan patch perbaikan.`;
            showToast("Debug prompt generated!");
        }

        function copyTextToClipboard(text, successMsg = "Copied!") {
            const ta = document.createElement("textarea");
            ta.value = text;
            document.body.appendChild(ta);
            ta.select();
            document.execCommand('copy');
            document.body.removeChild(ta);
            showToast(successMsg);
            logActivity("Copied prompt.");
        }

        function showToast(msg) {
            const container = document.getElementById('toast-container');
            const toast = document.createElement('div');
            toast.className = `pointer-events-auto px-4 py-2.5 rounded-lg border bg-slate-900 border-emerald-800 text-slate-100 text-xs font-medium shadow-xl`;
            toast.innerHTML = `<span>${escapeHTML(msg)}</span>`;
            container.appendChild(toast);
            setTimeout(() => toast.remove(), 3000);
        }

        function escapeHTML(str) {
            if (!str) return '';
            return str.replace(/[&<>'"]/g, tag => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;' }[tag] || tag));
        }

        function escapeJsString(str) {
            if (!str) return '';
            return str.replace(/\\/g, '\\\\').replace(/`/g, '\\`');
        }
    </script>
</body>
</html>
